#include <windows.h>

@SPOOLCUT_ICON_RESOURCE@
1 RT_MANIFEST "@SPOOLCUT_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@SPOOLCUT_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@SPOOLCUT_VERSION@\0"
            VALUE "ProductName", "SpoolCut"
            VALUE "ProductVersion", "@SPOOLCUT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
