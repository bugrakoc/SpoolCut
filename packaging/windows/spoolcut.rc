101 ICON "spoolcut.ico"
1 24 "spoolcut.manifest"

1 VERSIONINFO
 FILEVERSION APP_MAJOR, APP_MINOR, APP_PATCH, 0
 PRODUCTVERSION APP_MAJOR, APP_MINOR, APP_PATCH, 0
 FILEOS 0x40004
 FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SpoolCut"
            VALUE "FileVersion", APP_VERSION
            VALUE "InternalName", "spoolcut-desktop"
            VALUE "OriginalFilename", "SpoolCut.exe"
            VALUE "ProductName", "SpoolCut"
            VALUE "ProductVersion", APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
