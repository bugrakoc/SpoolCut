function(spoolcut_windows_resources target description app_id icon)
    set(resource_dir "${PROJECT_SOURCE_DIR}/packaging/windows")
    set(SPOOLCUT_FILE_DESCRIPTION "${description}")
    set(SPOOLCUT_WINDOWS_ID "${app_id}")
    set(SPOOLCUT_ICON_RESOURCE "")
    if(icon)
        set(SPOOLCUT_ICON_RESOURCE "1 ICON \"${resource_dir}/${icon}\"")
    endif()
    set(SPOOLCUT_MANIFEST "${CMAKE_CURRENT_BINARY_DIR}/${target}.manifest")
    configure_file("${resource_dir}/spoolcut.manifest.in" "${SPOOLCUT_MANIFEST}" @ONLY)
    configure_file("${resource_dir}/spoolcut.rc.in" "${CMAKE_CURRENT_BINARY_DIR}/${target}.rc" @ONLY)
    target_sources(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/${target}.rc")
endfunction()
