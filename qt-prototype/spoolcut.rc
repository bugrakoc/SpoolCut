#include <windows.h>

1 ICON "qt-prototype.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SPOOLCUT_VERSION_MAJOR,SPOOLCUT_VERSION_MINOR,SPOOLCUT_VERSION_PATCH,0
PRODUCTVERSION SPOOLCUT_VERSION_MAJOR,SPOOLCUT_VERSION_MINOR,SPOOLCUT_VERSION_PATCH,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SpoolCut"
            VALUE "FileVersion", SPOOLCUT_VERSION
            VALUE "ProductName", "SpoolCut"
            VALUE "ProductVersion", SPOOLCUT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
